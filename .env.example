# Node Mode — API Keys
# Copy this file to .env.local and fill in your keys.
# All API keys are stored locally in your browser via localStorage — they are never sent anywhere except directly to the respective AI provider.

# OpenAI (for GPT-4 / DALL·E nodes)
VITE_OPENAI_API_KEY=

# Anthropic (for Claude nodes)
VITE_ANTHROPIC_API_KEY=

# Google AI / Gemini (for Gemini text & image nodes)
VITE_GOOGLE_AI_API_KEY=

# Stability AI (for Stable Diffusion image nodes)
VITE_STABILITY_AI_API_KEY=

# Perplexity (for online search-augmented text nodes)
VITE_PERPLEXITY_API_KEY=

# Luma AI (for video generation nodes)
VITE_LUMA_API_KEY=

# Runway ML (for video & image generation nodes)
VITE_RUNWAY_API_KEY=

# Replicate (for 3D model, audio, and TTS nodes)
VITE_REPLICATE_API_KEY=
